# Source this file or copy values into your shell before launching
# scripts/branchingflows/run_qm9_paper.sh.

# Use one of these inputs:
# export TYR_QM9_JSONL=/data/qm9_branching.jsonl
# export TYR_QM9_XYZ_DIR=/data/qm9_xyz

export TYR_QM9_PROFILE=paper-qm9-main
export TYR_QM9_RUN_ROOT=output/branchingflows/qm9-paper-main

# Paper main unconditional figure: 800k iterations, 10k generated samples.
# Appendix recipe also mentions 500k batches; use paper-qm9-appendix for that.
export TYR_QM9_STEPS=800000
export TYR_QM9_TOTAL_STEPS=800000
export TYR_QM9_BATCH_SIZE=128
export TYR_QM9_ARCHITECTURE=full
export TYR_QM9_HIDDEN_DIM=384
export TYR_QM9_HEADS=12
export TYR_QM9_HEAD_DIM=64
export TYR_QM9_MLP=1536
export TYR_QM9_RFF_DIM=64
export TYR_QM9_LAYERS=12
export TYR_QM9_COORD_UPDATE_LAYERS=6
# Julia demo loss balance and branch-time oversampling defaults. The executable
# already uses these values; exporting them makes the run manifest explicit.
export TYR_QM9_COORD_WEIGHT=10
export TYR_QM9_LABEL_WEIGHT=0.3333333333333333
export TYR_QM9_SPLITS_WEIGHT=1
export TYR_QM9_DEL_WEIGHT=1
export TYR_QM9_BRANCHING_TIME_PROB=0.5
export TYR_QM9_SAMPLE_COUNT=10000
export TYR_QM9_SAMPLE_STEPS=1000

# Dry-run overrides:
# export TYR_QM9_PROFILE=smoke
# export TYR_QM9_MAX_MOLECULES=128
# export TYR_QM9_ARCHITECTURE=full
# export TYR_QM9_HIDDEN_DIM=16
# export TYR_QM9_HEADS=2
# export TYR_QM9_HEAD_DIM=8
# export TYR_QM9_MLP=32
# export TYR_QM9_RFF_DIM=4
# export TYR_QM9_LAYERS=2
# export TYR_QM9_COORD_UPDATE_LAYERS=1
# export TYR_QM9_STEPS=20
# export TYR_QM9_TOTAL_STEPS=20
# export TYR_QM9_BATCH_SIZE=4
# export TYR_QM9_SAMPLE_COUNT=2
# export TYR_QM9_SAMPLE_STEPS=8
